XIAOMI_API_KEY=sk-REPLACE_ME
XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1/chat/completions
MIMO_TEXT_MODEL=mimo-v2.5
MIMO_VISION_MODEL=mimo-v2.5
PI_CONTROL_REQUIRE_CONFIRM=false
PI_CONTROL_ACTION_DELAY_MS=700
PI_CONTROL_SCROLL_STEP=6
PI_CONTROL_SCROLL_REPEAT=1
PI_CONTROL_SCROLL_DELAY_MS=120
PI_CONTROL_SCROLL_OVERLAP_RATIO=0.1
PI_CONTROL_SCROLL_MIN_OVERLAP_RATIO=0.01
PI_CONTROL_SCROLL_CALIBRATION_STEP=3
PI_CONTROL_SCROLL_OUTPUT_STITCHED=false
PI_CONTROL_LONG_CAPTURE_MAX_FRAMES=40
PI_CONTROL_LONG_CAPTURE_UNCHANGED_FRAMES=2
PI_CONTROL_LONG_CAPTURE_OUTPUT_DIR=.wechat-audit/screenshots
